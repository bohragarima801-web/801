# ================================================================
# DivyaYagyam — Environment Variables Template
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env or .env.local to version control!
# ================================================================

# ── Database (Supabase Postgres + PgBouncer) ─────────────────────
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXXX"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_XXXXXXXXXXXXXXXXXXXXX"

# ── Razorpay ──────────────────────────────────────────────────────
# Use rzp_test_* for test mode, rzp_live_* for production
RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXXX"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXXX"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ── Admin Auth ────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET="your-64-char-random-hex-secret"

# ── Cron Authorization ────────────────────────────────────────────
# Must match Authorization: Bearer <CRON_SECRET> header in cron requests
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"

# ── Meta / Facebook Pixel ─────────────────────────────────────────
NEXT_PUBLIC_FB_PIXEL_ID="your-fb-pixel-id"
FB_PIXEL_ID="your-fb-pixel-id"
META_CAPI_ACCESS_TOKEN="your-meta-capi-access-token"
META_CAPI_TOKEN="your-meta-capi-token"

# ── Site Configuration ────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://divyayagyam.com"

# ── WhatsApp Admin Notifications ─────────────────────────────────
# Phone number for admin WhatsApp alerts (with country code, no +)
ADMIN_WHATSAPP_PHONE="919587171984"

# ── Vercel (Auto-set by Vercel, do not add manually) ─────────────
# VERCEL_OIDC_TOKEN — auto-injected by Vercel
