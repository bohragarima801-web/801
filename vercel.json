{
  "crons": [
    {
      "path": "/api/cron/auto-blog",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 2 * * *"
    }
  ],
  "ignoreCommand": "bash -c 'if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi'",
  "functions": {
    "app/api/admin/blogs/auto-generate/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/auto-blog/route.ts": {
      "maxDuration": 60
    }
  }
}
